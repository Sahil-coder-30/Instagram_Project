# ==============================================================================
# Backend Environment Configuration Example
# Copy this file to .env and replace placeholder values with your credentials.
# DO NOT commit real secrets or credentials to GitHub!
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# MongoDB Atlas / Local Connection URI
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/instagram?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/instagram

# JWT Secret Key for token signing and cookie verification (min 32 characters recommended)
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_32_chars

# ImageKit Private API Key (Used for secure server-side image uploads)
IMAGEKIT_PRIVATEKEY=your_imagekit_private_key_here
