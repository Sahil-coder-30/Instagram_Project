# ==============================================================================
# Frontend Environment Configuration Example
# Copy this file to .env and adjust the backend server URL if needed.
# ==============================================================================

# Backend API Base URL (Default for local development: http://localhost:3000)
# For production deployment (e.g. Vercel / Render), set to your backend URL:
# VITE_SERVER=https://your-backend-domain.com
VITE_SERVER=http://localhost:3000
